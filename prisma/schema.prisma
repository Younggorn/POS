generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductCategory {
  id       String    @id @db.VarChar(4)
  name     String    @db.VarChar(60)
  products Product[]

  @@map("product_categories")
}

model Product {
  code             String           @id @db.VarChar(25)
  categoryId       String?          @db.VarChar(4)
  category         ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  lotId            String?          @db.VarChar(5)
  name             String           @db.VarChar(80)
  alternateName    String?          @db.VarChar(100)
  quantity         Decimal          @default(0) @db.Decimal(18, 3)
  unit             String?          @db.VarChar(12)
  cost             Decimal          @default(0) @db.Decimal(18, 2)
  price            Decimal          @default(0) @db.Decimal(18, 2)
  price1           Decimal          @default(0) @db.Decimal(18, 2)
  price2           Decimal          @default(0) @db.Decimal(18, 2)
  price3           Decimal          @default(0) @db.Decimal(18, 2)
  price4           Decimal          @default(0) @db.Decimal(18, 2)
  minStock         Decimal          @default(0) @db.Decimal(18, 3)
  maxStock         Decimal          @default(0) @db.Decimal(18, 3)
  trackSerial      Boolean          @default(false)
  trackExpiry      Boolean          @default(false)
  shelfLifeDays    Int?
  promotionEnabled Boolean          @default(false)
  inactive         Boolean          @default(false)
  addedBy          String?          @db.VarChar(30)
  legacyDate       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  inventoryLots    InventoryLot[]
  productUnits     ProductUnit[]

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

model Supplier {
  code       String            @id @db.VarChar(5)
  name       String            @db.VarChar(80)
  contact    String?           @db.VarChar(50)
  address1   String?           @db.VarChar(70)
  address2   String?           @db.VarChar(70)
  phone      String?           @db.VarChar(40)
  fax        String?           @db.VarChar(40)
  website    String?           @db.VarChar(50)
  email      String?           @db.VarChar(50)
  creditDays Int               @default(0)
  taxId      String?           @db.VarChar(25)
  detail     String?           @db.VarChar(200)
  receipts   PurchaseReceipt[]

  @@index([name])
  @@map("suppliers")
}

model Customer {
  code        String       @id @db.VarChar(6)
  name        String       @db.VarChar(80)
  address1    String?      @db.VarChar(70)
  address2    String?      @db.VarChar(70)
  phone       String?      @db.VarChar(40)
  fax         String?      @db.VarChar(40)
  email       String?      @db.VarChar(50)
  contact     String?      @db.VarChar(40)
  priceLevel  Int          @default(0)
  creditDays  Int          @default(0)
  taxId       String?      @db.VarChar(25)
  detail      String?      @db.VarChar(200)
  sales       Sale[]
  receivables Receivable[]

  @@index([name])
  @@map("customers")
}

model Sale {
  id             String       @id @db.VarChar(13)
  invoiceNo      String?      @db.VarChar(13)
  taxInvoiceNo   String?      @db.VarChar(13)
  customerCode   String?      @db.VarChar(6)
  customer       Customer?    @relation(fields: [customerCode], references: [code], onDelete: SetNull)
  paymentType    String?      @db.VarChar(1)
  dueDate        DateTime?
  discountRate   Decimal      @default(0) @db.Decimal(18, 2)
  discountType   String?      @db.VarChar(8)
  discountAmount Decimal      @default(0) @db.Decimal(18, 2)
  vatType        String?      @db.VarChar(1)
  vatAmount      Decimal      @default(0) @db.Decimal(18, 2)
  subtotal       Decimal      @default(0) @db.Decimal(18, 2)
  total          Decimal      @default(0) @db.Decimal(18, 2)
  soldBy         String?      @db.VarChar(30)
  soldAt         DateTime?
  status         String?      @db.VarChar(1)
  cancelled      Boolean      @default(false)
  cancelReason   String?      @db.VarChar(200)
  cancelledAt    DateTime?
  cancelledBy    String?      @db.VarChar(30)
  items          SaleItem[]
  payments       SalePayment[]
  returns        SaleReturn[]
  receivables    Receivable[]
  shiftId        Int?
  shift          CashShift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([soldAt])
  @@index([customerCode])
  @@index([shiftId])
  @@map("sales")
}

model SalePayment {
  id             BigInt   @id @default(autoincrement())
  saleId         String   @db.VarChar(13)
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method         String   @db.VarChar(12)
  amount         Decimal  @db.Decimal(18, 2)
  receivedAmount Decimal? @db.Decimal(18, 2)
  changeAmount   Decimal? @db.Decimal(18, 2)
  reference      String?  @db.VarChar(50)
  createdAt      DateTime @default(now())

  @@unique([saleId, method])
  @@index([method, createdAt])
  @@map("sale_payments")
}

model SaleItem {
  id              BigInt              @id @default(autoincrement())
  saleId          String              @db.VarChar(13)
  sale            Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productCode     String?             @db.VarChar(25)
  serialNumber    String?             @db.VarChar(50)
  lotId           String?             @db.VarChar(5)
  quantity        Decimal             @default(0) @db.Decimal(18, 3)
  unit            String?             @db.VarChar(12)
  unitPrice       Decimal             @default(0) @db.Decimal(18, 2)
  unitDiscount    Decimal             @default(0) @db.Decimal(18, 2)
  unitCost        Decimal             @default(0) @db.Decimal(18, 2)
  promotionStatus String?             @db.VarChar(1)
  returnItems     SaleReturnItem[]
  lotAllocations  SaleLotAllocation[]
  productUnitId   BigInt?
  productUnit     ProductUnit?        @relation(fields: [productUnitId], references: [id], onDelete: SetNull)
  conversionRate  Decimal             @default(1) @db.Decimal(18, 3)
  baseQuantity    Decimal             @default(0) @db.Decimal(18, 3)
  scannedBarcode  String?             @db.VarChar(50)

  @@index([saleId])
  @@index([productCode])
  @@map("sale_items")
}

model PurchaseReceipt {
  id           String                @id @db.VarChar(13)
  supplierCode String?               @db.VarChar(5)
  supplier     Supplier?             @relation(fields: [supplierCode], references: [code], onDelete: SetNull)
  stockDate    DateTime?
  deliveryNo   String?               @db.VarChar(20)
  taxInvoiceNo String?               @db.VarChar(20)
  deliveryDate DateTime?
  vatType      String?               @db.VarChar(1)
  vatAmount    Decimal               @default(0) @db.Decimal(18, 2)
  total        Decimal               @default(0) @db.Decimal(18, 2)
  receivedBy   String?               @db.VarChar(30)
  receivedAt   DateTime?
  status       String?               @db.VarChar(1)
  items        PurchaseReceiptItem[]
  cancelled    Boolean               @default(false)
  cancelReason String?               @db.VarChar(200)

  @@index([supplierCode])
  @@index([stockDate])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id             BigInt          @id @default(autoincrement())
  receiptId      String          @db.VarChar(13)
  receipt        PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productCode    String?         @db.VarChar(25)
  lotId          String?         @db.VarChar(5)
  quantity       Decimal         @default(0) @db.Decimal(18, 3)
  unit           String?         @db.VarChar(12)
  unitCost       Decimal         @default(0) @db.Decimal(18, 2)
  discount       Decimal         @default(0) @db.Decimal(18, 2)
  inventoryLot   InventoryLot?
  productUnitId  BigInt?
  productUnit    ProductUnit?    @relation(fields: [productUnitId], references: [id], onDelete: SetNull)
  conversionRate Decimal         @default(1) @db.Decimal(18, 3)
  baseQuantity   Decimal         @default(0) @db.Decimal(18, 3)

  @@index([receiptId])
  @@index([productCode])
  @@map("purchase_receipt_items")
}

model ProductUnit {
  id             BigInt                @id @default(autoincrement())
  productCode    String                @db.VarChar(25)
  product        Product               @relation(fields: [productCode], references: [code], onDelete: Cascade, onUpdate: Cascade)
  name           String                @db.VarChar(20)
  barcode        String                @unique @db.VarChar(50)
  conversionRate Decimal               @db.Decimal(18, 3)
  salePrice      Decimal               @db.Decimal(18, 2)
  purchaseCost   Decimal?              @db.Decimal(18, 2)
  isBase         Boolean               @default(false)
  canSell        Boolean               @default(true)
  canPurchase    Boolean               @default(true)
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  saleItems      SaleItem[]
  purchaseItems  PurchaseReceiptItem[]
  barcodes       ProductBarcode[]

  @@unique([productCode, name])
  @@index([productCode, active])
  @@map("product_units")
}

model ProductBarcode {
  id            BigInt      @id @default(autoincrement())
  productUnitId BigInt
  productUnit   ProductUnit @relation(fields: [productUnitId], references: [id], onDelete: Cascade)
  barcode       String      @unique @db.VarChar(50)
  isPrimary     Boolean     @default(false)
  active        Boolean     @default(true)
  note          String?     @db.VarChar(100)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([productUnitId, active])
  @@map("product_barcodes")
}

model StockMovement {
  id           BigInt    @id @default(autoincrement())
  productCode  String?   @db.VarChar(25)
  lotId        String?   @db.VarChar(5)
  productName  String?   @db.VarChar(80)
  categoryName String?   @db.VarChar(60)
  quantityIn   Decimal   @default(0) @db.Decimal(18, 3)
  unitCost     Decimal   @default(0) @db.Decimal(18, 2)
  balance      Decimal   @default(0) @db.Decimal(18, 3)
  actor        String?   @db.VarChar(30)
  occurredAt   DateTime?
  status       String?   @db.VarChar(1)
  note         String?   @db.VarChar(200)

  @@index([productCode, occurredAt])
  @@map("stock_movements")
}

model ShopSetting {
  id           Int     @id @default(1)
  name         String  @db.VarChar(80)
  owner        String? @db.VarChar(50)
  headOrBranch String? @db.VarChar(1)
  branchNo     String? @db.VarChar(3)
  taxId        String? @db.VarChar(30)
  address1     String? @db.VarChar(70)
  address2     String? @db.VarChar(70)
  phone        String? @db.VarChar(40)
  email        String? @db.VarChar(50)
  vatRate      Decimal @default(7) @db.Decimal(5, 2)
  promptPay    String? @db.VarChar(20)

  @@map("shop_settings")
}

model Receivable {
  id             BigInt        @id @default(autoincrement())
  customerCode   String        @db.VarChar(6)
  customer       Customer      @relation(fields: [customerCode], references: [code], onDelete: Restrict)
  saleId         String?       @db.VarChar(13)
  sale           Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  documentNo     String        @unique @db.VarChar(20)
  originalAmount Decimal       @db.Decimal(18, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(18, 2)
  dueDate        DateTime
  status         String        @default("OPEN") @db.VarChar(10)
  note           String?       @db.VarChar(200)
  createdAt      DateTime      @default(now())
  payments       DebtPayment[]

  @@index([customerCode, status])
  @@index([dueDate])
  @@map("receivables")
}

model DebtPayment {
  id           BigInt     @id @default(autoincrement())
  receivableId BigInt
  receivable   Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  amount       Decimal    @db.Decimal(18, 2)
  method       String     @db.VarChar(12)
  batchId      String     @db.VarChar(36)
  receivedAmount Decimal? @db.Decimal(18, 2)
  changeAmount Decimal?   @db.Decimal(18, 2)
  reference    String?    @db.VarChar(50)
  receivedBy   String?    @db.VarChar(30)
  receivedAt   DateTime   @default(now())
  note         String?    @db.VarChar(200)

  @@index([receivableId, receivedAt])
  @@index([batchId])
  @@map("debt_payments")
}

model SaleReturn {
  id           String           @id @db.VarChar(15)
  saleId       String           @db.VarChar(13)
  sale         Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  total        Decimal          @db.Decimal(18, 2)
  reason       String           @db.VarChar(200)
  refundMethod String?          @db.VarChar(12)
  returnedBy   String?          @db.VarChar(30)
  returnedAt   DateTime         @default(now())
  items        SaleReturnItem[]

  @@index([saleId, returnedAt])
  @@map("sale_returns")
}

model SaleReturnItem {
  id             BigInt                    @id @default(autoincrement())
  returnId       String                    @db.VarChar(15)
  saleReturn     SaleReturn                @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId     BigInt
  saleItem       SaleItem                  @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  productCode    String?                   @db.VarChar(25)
  quantity       Decimal                   @db.Decimal(18, 3)
  unitPrice      Decimal                   @db.Decimal(18, 2)
  amount         Decimal                   @db.Decimal(18, 2)
  lotAllocations SaleReturnLotAllocation[]

  @@index([saleItemId])
  @@map("sale_return_items")
}

model InventoryLot {
  id                BigInt                    @id @default(autoincrement())
  productCode       String                    @db.VarChar(25)
  product           Product                   @relation(fields: [productCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  purchaseItemId    BigInt?                   @unique
  purchaseItem      PurchaseReceiptItem?      @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)
  lotNo             String                    @db.VarChar(50)
  receivedDate      DateTime
  manufacturedDate  DateTime?
  expireDate        DateTime
  initialQuantity   Decimal                   @db.Decimal(18, 3)
  quantity          Decimal                   @db.Decimal(18, 3)
  status            String                    @default("ACTIVE") @db.VarChar(12)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  saleAllocations   SaleLotAllocation[]
  returnAllocations SaleReturnLotAllocation[]
  actions           InventoryLotAction[]

  @@index([productCode, expireDate, quantity])
  @@index([expireDate, status])
  @@map("inventory_lots")
}

model SaleLotAllocation {
  id         BigInt       @id @default(autoincrement())
  saleItemId BigInt
  saleItem   SaleItem     @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  lotId      BigInt
  lot        InventoryLot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  quantity   Decimal      @db.Decimal(18, 3)

  @@index([saleItemId])
  @@index([lotId])
  @@map("sale_lot_allocations")
}

model SaleReturnLotAllocation {
  id           BigInt         @id @default(autoincrement())
  returnItemId BigInt
  returnItem   SaleReturnItem @relation(fields: [returnItemId], references: [id], onDelete: Cascade)
  lotId        BigInt
  lot          InventoryLot   @relation(fields: [lotId], references: [id], onDelete: Restrict)
  quantity     Decimal        @db.Decimal(18, 3)

  @@index([returnItemId])
  @@index([lotId])
  @@map("sale_return_lot_allocations")
}

model InventoryLotAction {
  id         BigInt       @id @default(autoincrement())
  lotId      BigInt
  lot        InventoryLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  type       String       @db.VarChar(16)
  quantity   Decimal      @default(0) @db.Decimal(18, 3)
  reason     String?      @db.VarChar(200)
  actor      String?      @db.VarChar(30)
  occurredAt DateTime     @default(now())

  @@index([lotId, occurredAt])
  @@map("inventory_lot_actions")
}

model CashShift {
  id           Int            @id @default(autoincrement())
  openedBy     String         @db.VarChar(30)
  openedAt     DateTime       @default(now())
  openingCash  Decimal        @db.Decimal(18, 2)
  closedBy     String?        @db.VarChar(30)
  closedAt     DateTime?
  countedCash  Decimal?       @db.Decimal(18, 2)
  expectedCash Decimal?       @db.Decimal(18, 2)
  difference   Decimal?       @db.Decimal(18, 2)
  status       String         @default("OPEN") @db.VarChar(10)
  note         String?        @db.VarChar(200)
  sales        Sale[]
  movements    CashMovement[]

  @@index([status, openedAt])
  @@map("cash_shifts")
}

model CashMovement {
  id         BigInt    @id @default(autoincrement())
  shiftId    Int
  shift      CashShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type       String    @db.VarChar(12)
  amount     Decimal   @db.Decimal(18, 2)
  reason     String    @db.VarChar(200)
  actor      String?   @db.VarChar(30)
  occurredAt DateTime  @default(now())

  @@index([shiftId, occurredAt])
  @@map("cash_movements")
}

model Device {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(60)
  type       String   @db.VarChar(20)
  connection String?  @db.VarChar(100)
  enabled    Boolean  @default(true)
  note       String?  @db.VarChar(200)
  updatedAt  DateTime @updatedAt

  @@map("devices")
}

model LegacyImportRun {
  id          Int       @id @default(autoincrement())
  sourcePath  String
  sourceSize  BigInt
  sourceMtime DateTime
  tableCounts Json
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String    @default("running") @db.VarChar(20)
  error       String?

  @@map("legacy_import_runs")
}

model LegacySyncProductState {
  oldCode        String   @id @db.VarChar(25)
  productCode    String   @db.VarChar(25)
  sourceQuantity Decimal  @db.Decimal(18, 3)
  sourceUpdatedAt DateTime?
  syncedAt       DateTime @default(now())

  @@index([productCode])
  @@map("legacy_sync_product_states")
}

model LegacySyncEntity {
  entityType String   @db.VarChar(24)
  sourceKey  String   @db.VarChar(80)
  sourceHash String   @db.Char(64)
  syncedAt   DateTime @default(now())

  @@id([entityType, sourceKey])
  @@map("legacy_sync_entities")
}

model LegacySyncCursor {
  sourcePath       String   @id
  sourceSize       BigInt
  sourceMtime      DateTime
  stockLogRows     Int      @default(0)
  lastSuccessAt    DateTime?
  lastStatus       String   @default("pending") @db.VarChar(20)
  lastMessage      String?
  updatedAt        DateTime @updatedAt

  @@map("legacy_sync_cursors")
}

model Position {
  id          Int                  @id @default(autoincrement())
  name        String               @unique @db.VarChar(80)
  description String?              @db.VarChar(200)
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  permissions PositionPermission[]
  employees   Employee[]

  @@map("positions")
}

model PositionPermission {
  positionId Int
  menuId     String   @db.VarChar(40)
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@id([positionId, menuId])
  @@index([menuId])
  @@map("position_permissions")
}

model Employee {
  id                 Int           @id @default(autoincrement())
  username           String        @unique @db.VarChar(50)
  name               String        @db.VarChar(100)
  passwordHash       String        @db.VarChar(255)
  positionId         Int
  position           Position      @relation(fields: [positionId], references: [id], onDelete: Restrict)
  active             Boolean       @default(true)
  mustChangePassword Boolean       @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  sessions           AuthSession[]
  loginLogs          LoginLog[]

  @@index([positionId, active])
  @@map("employees")
}

model LoginLog {
  id         BigInt    @id @default(autoincrement())
  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  username   String    @db.VarChar(50)
  eventType  String    @db.VarChar(16)
  success    Boolean
  reason     String?   @db.VarChar(40)
  ipAddress  String?   @db.VarChar(64)
  userAgent  String?   @db.VarChar(500)
  occurredAt DateTime  @default(now())

  @@index([occurredAt])
  @@index([employeeId, occurredAt])
  @@index([eventType, success, occurredAt])
  @@map("login_logs")
}

model SystemAuditLog {
  id         BigInt   @id @default(autoincrement())
  action     String   @db.VarChar(40)
  actorId    Int?
  actorName  String?  @db.VarChar(100)
  target     String?  @db.VarChar(255)
  success    Boolean
  detail     String?  @db.VarChar(500)
  occurredAt DateTime @default(now())

  @@index([action, occurredAt])
  @@index([actorId, occurredAt])
  @@map("system_audit_logs")
}

model AuthSession {
  id         BigInt   @id @default(autoincrement())
  tokenHash  String   @unique @db.Char(64)
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([employeeId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model HeldBill {
  id        Int      @id @default(autoincrement())
  label     String   @db.VarChar(80)
  itemCount Int
  total     Decimal  @db.Decimal(18, 2)
  items     Json
  customer  Json?
  heldBy    String?  @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("held_bills")
}
